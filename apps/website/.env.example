# Runtime (Dokploy)
MONGODB_URI=
MONGODB_DATABASE=default
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Central MAC auth service. Both are optional; these are the defaults.
AUTH_URL=https://auth.monashcoding.com
JWT_AUDIENCE=mac-suite

# Build time (inlined into the browser bundle). PostHog stays off when empty.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
