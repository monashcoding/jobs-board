# Database configuration
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=

# Scraping configuration
SCRAPING_TYPE=SCHEDULE # SCHEDULE (Scraper runs at the time specified below each day) | INSTANT (Scraper runs instantly)
SCRAPING_TIME_HOUR=0 # Hour you want to schedule the scraping to run (24-hour format)
SCRAPING_TIME_MINUTE=0  # Minute you want to schedule the scraping to run (0-60)