# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mploy
MONGODB_COLLECTION=jobs

# BrightData Configuration (Proxy Service)
BRIGHTDATA_CUSTOMER_ID=your_customer_id
BRIGHTDATA_ZONE_NAME=your_zone_name
BRIGHTDATA_PASSWORD=your_password

# Ollama
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# Discord Webhook for logging
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Environment (DEVELOPMENT or PRODUCTION)
ENVIRONMENT=DEVELOPMENT

# Version information
VERSION=1.0.0

# Scraper Configuration
# Comma-separated list of scrapers to run (leave empty to run all)
# Options: GradConnection,Prosple,LinkedIn,JaneStreet,Atlassian
RUN_SCRAPERS=

# Pipeline Steps Configuration
# Comma-separated list of pipeline steps to run (leave empty to run all)
# Options: WriteJSON,Normalisation,Deduplication,Synchronisation,AIParser,Upload
RUN_PIPELINE_STEPS=

# Scraper Job Limits (for development/testing)
# Format: SCRAPER_NAME:LIMIT (comma-separated)
# Example: LINKEDIN:10,GRADCONNECTION:5,PROSPLE:20
SCRAPER_JOB_LIMITS=